# ===== Base de datos (MySQL local) =====
DB_URL=jdbc:mysql://localhost:3306/wevently
DB_USERNAME=root
DB_PASSWORD=tu_password
MYSQL_DATABASE=wevently

# ===== Backups =====
# Carpeta (relativa al proyecto) donde se guardan los .sql
BACKUP_DIRECTORY=backups
# Carpeta con mysqldump y mysql (por defecto: C:\Program Files\MySQL\MySQL Server 9.2\bin)
# MYSQL_BIN_DIR=/usr/bin

# ===== PostgreSQL (opcional, remoto) =====
PG_URL=
PG_USERNAME=
PG_PASSWORD=

# ===== JWT =====
# Clave de al menos 256 bits (32+ caracteres)
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-32-caracteres
JWT_EXPIRATION_MS=86400000

# ===== HTTPS (opcional) =====
SERVER_SSL_KEY_STORE=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_KEY_ALIAS=

# ===== MercadoPago (access token de sandbox: TEST-...) =====
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx

# ===== Zoho Mail (envío de emails de recuperación de contraseña) =====
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REDIRECT_URI=
ZOHO_MAIL_ACCOUNT_EMAIL=
